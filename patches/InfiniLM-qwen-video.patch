+        throw std::runtime_error("Qwen35VisionModel: grid token count overflow");
+    }
+    if (t * h * w != patch_count) {
+        throw std::runtime_error("Qwen35VisionModel: pixel rows do not match T*H*W");
+    }
+    return h * w;
